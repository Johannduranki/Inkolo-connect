PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=duranki_app
DB_PASSWORD=
DB_NAME=duranki_login
# Required private secrets; preserve existing values when importing accounts.
ID_PEPPER=
JWT_SECRET=
# Required canonical base64 encoding of exactly 32 bytes. Preserve imported key.
MFA_ENCRYPTION_KEY=
JWT_EXPIRES_IN=1h
ALLOW_DEMO_AUTH=false
FORCE_DEMO_MODE=false
PLATFORM_STORAGE=mariadb
AUTH_STORAGE=mariadb
TREASURY_STORAGE=mariadb
TRAINING_STORAGE=mariadb
CYCLE_STORAGE=mariadb
HERITAGE_STORAGE=mariadb
# Readiness metadata is stored in MariaDB; no local keyfile is used.

# Cycle hosted checkout: use replacement secrets, never commit live credentials.
CYCLE_MODE=sandbox
CYCLE_ENABLED=false
CYCLE_LIVE_APPROVED=false
CYCLE_MERCHANT_ACCOUNT=Duranki
CYCLE_PAYWALL_SECRET=
CYCLE_NOTIFICATION_SECRET=
CYCLE_PUBLIC_URL=
# Set the merchant's GLOBAL notification URL to https://your-domain/api/cycle/notifications
# for Direct API renewals as well as hosted checkout. Keep one application writer.
# MariaDB cutover requires the SQL billing allocation adapter; do not enable collection during cutover.
# Keep disabled until provider sandbox acceptance and production approval.
CYCLE_WALLET_TOPUPS_ENABLED=false
CYCLE_RECURRING_ENABLED=false
CYCLE_API_BASE_URL=
CYCLE_API_CALLER_NAME=
CYCLE_API_CALLER_PASSWORD=
# Confirm the saved profile field path in an INITIAL notification with Cycle.
CYCLE_PROFILE_ID_PATH=
# 32 random bytes encoded as 64 hex characters; retain securely for token decryption.
CYCLE_TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=info
# Optional absolute directory; defaults to backend/logs. Never place logs in public/uploads.
# LOG_DIRECTORY=/var/log/duranki
