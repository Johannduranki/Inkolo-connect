# Private Compose interpolation file, not an application env_file.
# Copy outside Git; fill every blank before docker compose --env-file PATH ...
# Preserve existing secrets for imported accounts. Never use this file directly.
MARIADB_ROOT_PASSWORD=
DB_NAME=durankidemo_core
DB_USER=duranki_app
DB_PASSWORD=
ID_PEPPER=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
FRONTEND_ORIGIN=
NODE_ENV=production
# Existing HTTP dev/test only: NODE_ENV=development and
# FRONTEND_ORIGIN=http://app-dev.duranki.network. Production requires HTTPS.
# Use the same reviewed image for migrate and backend.
DURANKI_IMAGE=ghcr.io/johannduranki/inkolo-connect:latest
