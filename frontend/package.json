{
  "name": "duranki-id-login-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/static-routes.mjs",
    "test:routing": "node --test scripts/static-routes.test.mjs",
