    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@capacitor/android": "^7.6.6",
    "@capacitor/cli": "^7.6.6",
    "@capacitor/core": "^7.6.6",
    "cytoscape": "3.34.3",
    "duranki-id-login-module": "file:..",
    "rxjs": "~7.8.2",
    "tesseract.js": "7.0.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.40",
