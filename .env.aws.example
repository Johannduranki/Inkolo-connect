# Duranki AWS production environment example
# Copy these values into AWS Secrets Manager, Elastic Beanstalk environment
# properties, ECS task environment variables, or App Runner environment variables.

NODE_ENV=production
PORT=3000

# Public website URL. Replace this with the real domain.
FRONTEND_ORIGIN=https://www.your-domain.co.za
FRONTEND_ORIGINS=https://www.your-domain.co.za,https://your-domain.co.za

# AWS RDS MySQL connection.
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_USER=duranki_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=duranki_production

# Application secrets. Generate strong random values for production.
ID_PEPPER=replace-with-a-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=1h

# Production must keep demo mode disabled.
ALLOW_DEMO_AUTH=false
FORCE_DEMO_MODE=false
